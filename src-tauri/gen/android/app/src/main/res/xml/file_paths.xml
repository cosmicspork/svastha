<?xml version="1.0" encoding="utf-8"?>
<!-- Only what the WebView's camera capture needs: it writes the photo for an
     <input type="file" capture> into the app's own Pictures directory and
     hands the camera app a URI for that one file. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <external-files-path name="camera" path="Pictures/" />
</paths>
